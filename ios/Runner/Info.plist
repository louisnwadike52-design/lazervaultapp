<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>CFBundleDisplayName</key>
		<string>Lazervault</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>lazervaultapp</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>NSCameraUsageDescription</key>
		<string>LazerVault uses your camera to scan QR codes for payments, capture documents for KYC verification, and read card details for secure transfers.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>LazerVault uses your microphone for voice biometric authentication and the in-app voice assistant for payments and balance checks.</string>
		<key>NSContactsUsageDescription</key>
		<string>LazerVault uses your contacts to help you quickly send money to friends and family by name instead of typing account numbers.</string>
		<!-- ITMS-90683: required by App Store Connect because Flutter plugins
		     (image_picker, file_picker, mobile_scanner) reference photo
		     library / speech APIs. Apple requires a purpose string per API
		     even if a particular code path doesn't end up calling it. -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>LazerVault uses your photo library to attach receipts to expenses, upload KYC documents, and share transaction proofs.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>LazerVault saves receipts and transaction proofs to your photo library so you can share them or keep them for records.</string>
		<key>NSSpeechRecognitionUsageDescription</key>
		<string>LazerVault uses speech recognition to let you make payments, check your balance, and pay bills with voice commands.</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>LazerVault uses your location to detect unusual sign-in activity, surface nearby agents for cash deposits, and comply with anti-fraud regulations.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>LazerVault uses your location in the background to keep your account secure — flagging logins from new places and verifying transactions against your usual locations to prevent fraud.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>LazerVault uses your location in the background to keep your account secure — flagging logins from new places and verifying transactions against your usual locations to prevent fraud.</string>
		<key>NSFaceIDUsageDescription</key>
		<string>LazerVault uses Face ID to confirm payments, unlock the app, and authorise sensitive operations without a password.</string>
		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>LazerVault uses Bluetooth for contactless tap-to-pay between phones.</string>
		<key>NSBluetoothPeripheralUsageDescription</key>
		<string>LazerVault uses Bluetooth for contactless tap-to-pay between phones.</string>
		<key>NSLocalNetworkUsageDescription</key>
		<string>LazerVault discovers nearby devices on your local network for contactless tap-to-pay.</string>
		<!-- NFC purpose string for contactless tap-to-pay. Required by iOS
		     for any Core NFC session; without it CoreNFC throws at session
		     start and the user sees a generic "feature unavailable" error.
		     Paired with the NFC entitlement in Runner.entitlements. -->
		<key>NFCReaderUsageDescription</key>
		<string>LazerVault uses NFC to send and receive money by tapping your phone against another LazerVault user's phone.</string>
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>remote-notification</string>
			<string>fetch</string>
			<!-- BLE modes so contactless tap-to-pay can finish in the
			     background if the user backgrounds the app mid-handshake. -->
			<string>bluetooth-central</string>
			<string>bluetooth-peripheral</string>
		</array>
		<!-- Deep link URL scheme for lazervault:// -->
		<!-- Used for DirectPay authorization callbacks and other in-app redirects -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>app.lazervault</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>lazervault</string>
				</array>
			</dict>
		</array>
		<!-- Universal Links - Associated Domains configured in Xcode -->
		<key>FlutterDeepLinkingEnabled</key>
		<true/>
		<!-- Siri integration for voice-activated payments -->
		<key>NSSiriUsageDescription</key>
		<string>LazerVault uses Siri to let you quickly send money, check your balance, and pay bills with your voice.</string>
		<!-- App Icon Quick Actions (long-press shortcuts) -->
		<key>UIApplicationShortcutItems</key>
		<array>
			<dict>
				<key>UIApplicationShortcutItemType</key>
				<string>send_money</string>
				<key>UIApplicationShortcutItemTitle</key>
				<string>Send Money</string>
				<key>UIApplicationShortcutItemSubtitle</key>
				<string>Transfer funds instantly</string>
				<key>UIApplicationShortcutItemIconType</key>
				<string>UIApplicationShortcutIconTypeShuffle</string>
			</dict>
			<dict>
				<key>UIApplicationShortcutItemType</key>
				<string>scan_to_pay</string>
				<key>UIApplicationShortcutItemTitle</key>
				<string>Scan to Pay</string>
				<key>UIApplicationShortcutItemSubtitle</key>
				<string>QR code payment</string>
				<key>UIApplicationShortcutItemIconType</key>
				<string>UIApplicationShortcutIconTypeCapturePhoto</string>
			</dict>
			<dict>
				<key>UIApplicationShortcutItemType</key>
				<string>check_balance</string>
				<key>UIApplicationShortcutItemTitle</key>
				<string>Check Balance</string>
				<key>UIApplicationShortcutItemSubtitle</key>
				<string>View account balance</string>
				<key>UIApplicationShortcutItemIconType</key>
				<string>UIApplicationShortcutIconTypeSearch</string>
			</dict>
			<dict>
				<key>UIApplicationShortcutItemType</key>
				<string>pay_bills</string>
				<key>UIApplicationShortcutItemTitle</key>
				<string>Pay Bills</string>
				<key>UIApplicationShortcutItemSubtitle</key>
				<string>Electricity, airtime &amp; more</string>
				<key>UIApplicationShortcutItemIconType</key>
				<string>UIApplicationShortcutIconTypeTask</string>
			</dict>
		</array>
	</dict>
</plist>
