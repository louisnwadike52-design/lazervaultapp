<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Siri removed — the app uses speech_to_text + voice_biometrics, NOT SiriKit
	     intent capability. Re-add com.apple.developer.siri if SiriKit intent is
	     wired in the future (also enable Siri on the App ID in Apple Developer). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Apple App Attest, used by Firebase App Check for device attestation.
	     Set to `production`: the only builds that invoke real App Attest are
	     RELEASE builds (TestFlight/App Store), where AppCheckService uses
	     AppleProvider.appAttest and Apple requires the production environment.
	     DEBUG builds use the Firebase App Check DEBUG provider (no real App
	     Attest call), so this value is irrelevant to them. No Apple Developer
	     portal toggle is required — verification uses Apple's App Attest root CA. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal Links, so a notification link opens the app instead of Safari.
	     Without this key iOS ignores https://lazervault.app links entirely, no
	     matter what the site serves — which is why notification links minted by
	     notifications-service only worked through the lazervault:// scheme.

	     `applinks:` pairs with /.well-known/apple-app-site-association on the
	     site (public/.well-known/ in the lazervault-website repo, served as
	     application/json via a next.config.js header — an extensionless file
	     would otherwise go out as octet-stream and iOS would reject it
	     silently). The AASA claims /n/* (notification routing) and
	     /family/invite/* (the older invitation link).

	     ASSOCIATED_DOMAINS is already enabled on the App ID com.lazervault.app
	     (verified against the App Store Connect API), so the match AppStore
	     profile grants it. If codesign ever complains that the profile lacks
	     this entitlement, the profile predates the capability — regenerate with
	     `bundle exec fastlane match appstore --force`. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:lazervault.app</string>
	</array>
	<!-- NFC Tag Reading capability for contactless tap-to-pay.
	     Must ALSO be enabled on the App ID in the Apple Developer portal.
	     ONLY `TAG` here — NOT `NDEF`. The app reads/writes NDEF *through a
	     CoreNFC tag session* (nfc_manager 4.x: startSession(pollingOptions:
	     {iso14443, iso15693}) + Ndef.from(tag)), which is the `TAG` format.
	     The standalone `NDEF` format is for NFCNDEFReaderSession (which we
	     don't use) and Apple's binary validation REJECTS it when building
	     with the iOS 26 SDK at a 13.0 deployment target (altool error 90778:
	     "NDEF is disallowed"). Populate
	     `com.apple.developer.nfc.readersession.iso7816.select-identifiers`
	     when ISO 7816 / e-ID reading is added. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
