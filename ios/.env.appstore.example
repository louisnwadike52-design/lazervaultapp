# Copy to .env.appstore (gitignored) and fill in the three values from the .p8
# you downloaded from https://appstoreconnect.apple.com/access/integrations/api
#
# Then in any shell where you want to run the iOS lanes:
#   source lazervaultapp/ios/.env.appstore
#   bundle exec fastlane setup_appstore
#
# The same three values land in GitHub Actions as repo secrets — see
# .github/workflows/mobile-deploy.yml.

# 10-character Key ID from the Keys table (e.g. "ABCD123456").
export APP_STORE_CONNECT_KEY_ID=""

# UUID Issuer ID shown ABOVE the Keys table (one per ASC team).
export APP_STORE_CONNECT_ISSUER_ID=""

# Absolute path to the .p8 file you downloaded. Convention:
#   mkdir -p ~/.appstoreconnect/private_keys
#   mv ~/Downloads/AuthKey_<KEY_ID>.p8 ~/.appstoreconnect/private_keys/
# Then this line can be the default path:
export APP_STORE_CONNECT_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_${APP_STORE_CONNECT_KEY_ID}.p8"

# Optional Apple Developer Program identity used by Match + Deliver.
# Apple ID email tied to the Apple Developer Program enrollment.
export APPLE_ID=""
# 10-character Team ID from https://developer.apple.com/account#MembershipDetailsCard
export APPLE_TEAM_ID=""
# App Store Connect team id — usually the same as APPLE_TEAM_ID for solo teams.
export APPLE_ITC_TEAM_ID=""

# Optional fastlane match config (iOS code-signing). Skip on first run; set up
# AFTER setup_appstore succeeds and you've created a private certs repo.
export MATCH_GIT_URL=""
export MATCH_PASSWORD=""
