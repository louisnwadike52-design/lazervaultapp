default_platform(:ios)

require "base64"

FLUTTER_DIR = File.expand_path("../..", __dir__) # lazervaultapp/
IOS_DIR     = File.expand_path("..", __dir__)    # lazervaultapp/ios/

# DART_DEFINES expects a base64-encoded comma-separated list of key=value.
# Flutter's Xcode integration script (Run Script Build Phase) reads this env
# var and forwards the values to the Dart kernel-snapshot step.
def dart_defines_base64(*kvs)
  Base64.strict_encode64(kvs.join(","))
end

# Xcode build settings applied to every iOS release build for maximum
# binary size reduction:
#
# DEPLOYMENT_POSTPROCESSING=YES   Triggers post-processing (strip, etc.)
# STRIP_INSTALLED_PRODUCT=YES     Strip symbols from installed binaries
# STRIP_STYLE=all                 Strip every removable symbol (vs. debugging only)
# STRIP_SWIFT_SYMBOLS=YES         Strip Swift module names from the binary
# COPY_PHASE_STRIP=YES            Strip during the copy phase too
# DEAD_CODE_STRIPPING=YES         Linker eliminates unreferenced functions
# LLVM_LTO=YES                    Link-time optimization (cross-module inlining)
# SWIFT_COMPILATION_MODE=wholemodule  Required for LLVM_LTO + better inlining
# SWIFT_OPTIMIZATION_LEVEL=-O     Standard optimization (max for app)
# GCC_OPTIMIZATION_LEVEL=s        Optimize C code for size (-Os)
# ENABLE_BITCODE=NO               Bitcode is deprecated; off everywhere
# VALIDATE_PRODUCT=YES            Strip debug + reject malformed bundles
#
# Apple's App Thinning at install time slices the .ipa per-device so users
# only download what they need (architecture, asset variant, etc.) — these
# settings shrink the master IPA before Apple's slicing kicks in.
COMPRESSION_XCARGS = [
  "DEPLOYMENT_POSTPROCESSING=YES",
  "STRIP_INSTALLED_PRODUCT=YES",
  # STRIP_STYLE=non-global is Apple's recommended setting for App Store
  # distribution — strips debug symbols + local labels but preserves the
  # global symbols SwiftPM packages (webview_flutter_wkwebview,
  # url_launcher_ios, etc.) reference via dynamic linking. STRIP_STYLE=all
  # over-strips these and breaks the archive.
  "STRIP_STYLE=non-global",
  "STRIP_SWIFT_SYMBOLS=YES",
  "COPY_PHASE_STRIP=YES",
  "DEAD_CODE_STRIPPING=YES",
  # LLVM_LTO=YES intermittently breaks compilation of pre-built SPM
  # packages (resource_bundle_accessor.m on GoogleDataTransport hit a
  # frontend crash on Xcode 26 with LTO + Os). Skipped — the size win is
  # smaller than the other strip+optimize flags anyway.
  "SWIFT_COMPILATION_MODE=wholemodule",
  "SWIFT_OPTIMIZATION_LEVEL=-O",
  "GCC_OPTIMIZATION_LEVEL=s",
  "ENABLE_BITCODE=NO",
  "VALIDATE_PRODUCT=YES",
].join(" ")

# Dart side — same compression flags as Android (set in the DART_DEFINES env).
# Flutter's iOS Run Script Build Phase reads these via env vars and forwards
# them to the kernel snapshot step.
COMPRESSION_DART_ENV = {
  "TREE_SHAKE_ICONS"   => "true",
  "SPLIT_DEBUG_INFO"   => "#{FLUTTER_DIR}/build/symbols/ios",
  "OBFUSCATE"          => "true",
}

def flutter(args)
  # Run OUTSIDE the fastlane bundler env. `flutter build ios` shells out to
  # `pod`, but under `bundle exec` the gem-shim `pod` (NOT in this Gemfile)
  # shadows the brew CocoaPods → "can't find executable pod for gem cocoapods"
  # → flutter skips `pod install` → the non-SwiftPM plugins fail to build →
  # `flutter build ios` exits 1. with_unbundled_env restores the system
  # PATH/GEM env so the brew `pod` is used (same fix the pod-install lane uses).
  Bundler.with_unbundled_env do
    Dir.chdir(FLUTTER_DIR) { sh("flutter #{args}") }
  end
end

# --- Shorebird (OTA code-push) — mirrors android/fastlane/Fastfile -----------
# Shorebird runs ONLY when a lane is invoked with shorebird:true (patch-capable
# RELEASE build) or patch:true (Dart-only OTA patch to an already-shipped
# Shorebird release). Otherwise the plain gym build runs and the Shorebird plan
# is never touched. Pin to the app's Flutter version — Shorebird's bundled
# Flutter (a newer patch) failed the native-lib strip; keep in sync w/ pubspec.
SHOREBIRD_FLUTTER_VERSION = "3.44.2".freeze

# Patch-capable RELEASE via Shorebird — drop-in for gym build_app. Runs the iOS
# archive/export AND registers the release so future Dart-only changes ship OTA
# via `shorebird patch ios` (no App Store review). Produces an .ipa under
# build/ios/ipa (see newest_ipa). Uses the per-flavor app_id from shorebird.yaml.
# Runs outside the fastlane bundler env so brew `pod`/`flutter` resolve (same
# reason as flutter()). NOTE: the iOS Shorebird RELEASE path needs a first
# validated run — the patch path and the plain (non-Shorebird) path are proven.
def shorebird_release_ios(flavor, ver_name, ver_build)
  Bundler.with_unbundled_env do
    Dir.chdir(FLUTTER_DIR) do
      # --export-method app-store → emits a TestFlight/App-Store-ready signed IPA
      # (without it Shorebird can't produce a distributable archive). All flags
      # here are Shorebird's own (parsed before `--`); only --tree-shake-icons
      # (not a Shorebird flag) is forwarded to `flutter build` after `--`.
      # Shorebird runs non-interactively under fastlane's sh (no TTY), so no
      # confirm flag is needed (Shorebird has none — it just proceeds).
      sh("shorebird release ios --flavor #{flavor} --flutter-version=#{SHOREBIRD_FLUTTER_VERSION} " \
         "--export-method app-store --build-name=#{ver_name} --build-number=#{ver_build} " \
         "--dart-define=FLAVOR=#{flavor} --dart-define=FLUTTER_FLAVOR=#{flavor} " \
         "--obfuscate --split-debug-info=#{FLUTTER_DIR}/build/symbols/ios-#{flavor} " \
         "-- --tree-shake-icons")
    end
  end
end

# OTA code-push: Dart-only diff to an already-shipped Shorebird iOS release.
# No .ipa, no TestFlight upload — live on devices after the app relaunches.
def shorebird_patch_ios(flavor)
  Bundler.with_unbundled_env do
    Dir.chdir(FLUTTER_DIR) do
      # --release-version=latest targets the most recently shipped Shorebird
      # release for this flavor (the one testers are on). --dart-define is a
      # Shorebird patch flag (parsed before `--`).
      sh("shorebird patch ios --flavor #{flavor} --flutter-version=#{SHOREBIRD_FLUTTER_VERSION} " \
         "--release-version=latest " \
         "--dart-define=FLAVOR=#{flavor} --dart-define=FLUTTER_FLAVOR=#{flavor}")
    end
  end
end

# The .ipa the build just produced. gym honors output_name; Shorebird may not,
# so fall back to the newest .ipa under build/ios/ipa.
def resolve_ipa(preferred)
  return preferred if File.exist?(File.join(IOS_DIR, preferred)) || File.exist?(preferred)
  newest = Dir.glob(File.join(FLUTTER_DIR, "build/ios/ipa/*.ipa")).max_by { |f| File.mtime(f) }
  newest || UI.user_error!("No .ipa found under build/ios/ipa after the build")
end

def swap_firebase_plist(flavor)
  src = File.join(IOS_DIR, "config", flavor, "GoogleService-Info.plist")
  dst = File.join(IOS_DIR, "Runner", "GoogleService-Info.plist")
  FileUtils.cp(src, dst)
end

def release_notes
  `git -C #{FLUTTER_DIR} log -1 --pretty=%B`.strip
end

# Read "version: x.y.z+BUILD" from pubspec.yaml — the SINGLE source of truth for
# CFBundleShortVersionString (name) and CFBundleVersion (build). Returns
# [name, build] e.g. ["1.0.0", "17"].
#
# Why we pass these explicitly to gym instead of relying on the xcconfig:
# Info.plist resolves CFBundleVersion from $(FLUTTER_BUILD_NUMBER), which lives
# in the git-ignored ios/Flutter/Generated.xcconfig. `flutter pub get` does NOT
# refresh that file, and these lanes build via gym (not `flutter build ios`), so
# the IPA would otherwise archive a STALE build number and TestFlight rejects it
# ("bundle version already used"). Passing FLUTTER_BUILD_NUMBER/NAME on the gym
# xcargs command line overrides the stale xcconfig (command-line build settings
# win over .xcconfig), so the build number always tracks pubspec.
def pubspec_version
  raw = File.read(File.join(FLUTTER_DIR, "pubspec.yaml"))[/^version:\s*(\S+)/, 1]
  UI.user_error!("Could not parse 'version:' from pubspec.yaml") if raw.nil?
  name, build = raw.split("+", 2)
  UI.user_error!("pubspec version '#{raw}' missing +BUILD") if build.nil? || build.empty?
  [name, build]
end

APP_IDENTIFIER  = "com.lazervault.app"
SCHEME          = "Runner"
# Relative to the ios/ dir where fastlane runs (cwd is fastlane/Fastfile's parent).
WORKSPACE       = "Runner.xcworkspace"

# Resolve the App Store Connect API key from the env. The key is the .p8 you
# downloaded from https://appstoreconnect.apple.com/access/api once; we keep
# the actual file out of the repo and reference it by path.
def asc_api_key
  key_id     = ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id  = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_path   = ENV["APP_STORE_CONNECT_KEY_PATH"] || \
               File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  unless key_id && issuer_id && File.exist?(key_path)
    UI.user_error!(<<~MSG)
      App Store Connect API key not configured. Set in your shell:
        export APP_STORE_CONNECT_KEY_ID="XXXXXXXXXX"          # 10-char Key ID
        export APP_STORE_CONNECT_ISSUER_ID="xxxxxxxx-..."     # UUID from ASC → Keys
        export APP_STORE_CONNECT_KEY_PATH="/abs/path/AuthKey_XXXXXXXXXX.p8"
      Then run `fastlane setup_appstore` to verify.
    MSG
  end
  app_store_connect_api_key(
    key_id:      key_id,
    issuer_id:   issuer_id,
    key_filepath: key_path,
    duration:    1200,
    in_house:    false,
  )
end

platform :ios do
  desc "FIRST-TIME SETUP — verifies App Store Connect access, auto-creates the app listing if missing"
  lane :setup_appstore do
    key = asc_api_key
    UI.header "Verifying App Store Connect access for #{APP_IDENTIFIER}"

    # Try to fetch the latest build number — both proves auth AND proves the
    # App Store Connect listing exists. Returns 0 when it exists but has no
    # builds (the expected first-run state).
    begin
      build_num = latest_testflight_build_number(
        api_key:              key,
        app_identifier:       APP_IDENTIFIER,
        initial_build_number: 0,
      )
      UI.success "✅ ASC API key valid"
      UI.success "✅ App row found for #{APP_IDENTIFIER}"
      UI.message "   Latest TestFlight build number: #{build_num} #{build_num == 0 ? '(no builds uploaded yet)' : ''}"
    rescue => e
      UI.important "App row NOT found on App Store Connect — running `produce` to create it."
      UI.important "(Bundle ID is registered in Apple Developer Portal, but the App Store"
      UI.important " listing is a separate Apple resource that must exist before TestFlight"
      UI.important " uploads work. produce is the canonical fastlane way to create it.)"
      produce(
        api_key:        key,
        app_identifier: APP_IDENTIFIER,
        app_name:       "Lazervault",
        language:       "English",
        app_version:    "1.0",
        sku:            "LAZERVAULT_IOS_001",
        # Don't try to register the bundle id with the dev portal — the user
        # already did that manually. Only create the App Store Connect row.
        skip_itc:       false,
        skip_devcenter: true,
      )
      UI.success "✅ App listing created on App Store Connect"
    end

    UI.message ""
    UI.message "Next steps in order:"
    UI.message "  1. bundle exec fastlane sync_signing      # match — pulls/creates distribution certs"
    UI.message "  2. bundle exec fastlane beta              # build + upload to TestFlight internal"
    UI.message "  3. bundle exec fastlane production        # full release lane"
  end

  desc "Sync iOS code-signing via fastlane match. Run once on this machine."
  lane :sync_signing do
    unless ENV["MATCH_GIT_URL"]
      UI.user_error!(<<~MSG)
        MATCH_GIT_URL not set. fastlane match stores certs/profiles in a
        private git repo so any dev/CI box can pull them.
        Quick start:
          gh repo create lazervault/ios-certs --private --confirm
          export MATCH_GIT_URL="git@github.com:lazervault/ios-certs.git"
          export MATCH_PASSWORD="<a strong password — needed to decrypt>"
        Then re-run this lane.
      MSG
    end
    match(
      type: "appstore",
      app_identifier: [APP_IDENTIFIER],
      readonly: false,  # first run; flip to true on CI
      api_key: asc_api_key,
    )
  end

  desc "Upload an existing IPA to TestFlight (skips rebuild). Useful when manually built in Xcode."
  lane :testflight_upload_existing do |options|
    ipa = options[:ipa] || UI.user_error!("Pass ipa:'<path>' to this lane")
    upload_to_testflight(
      api_key:                              asc_api_key,
      ipa:                                  ipa,
      skip_waiting_for_build_processing:    true,
      changelog:                            (`git log -1 --pretty=%s`.strip),
    )
  end

  desc "Quick alias for the staging lane (TestFlight internal group)"
  lane :beta do
    staging
  end

  desc "Open Firebase Console pages for the APNs .p8 + VAPID upload (one-time setup)"
  lane :setup_push_credentials do
    UI.header "APNs + Web Push setup (one-time, per Firebase project)"
    UI.message "1. Apple Developer Console → Keys → '+' → enable 'Apple Push Notifications service (APNs)' → download .p8"
    UI.message "   https://developer.apple.com/account/resources/authkeys/list"
    UI.message ""
    UI.message "2. Upload that .p8 to EACH Firebase project (one per env):"
    %w[lazervault-dev lazervault-testnet lazervault-28875].each do |proj|
      UI.message "   - #{proj}: https://console.firebase.google.com/project/#{proj}/settings/cloudmessaging"
    end
    UI.message ""
    UI.message "3. Web Push VAPID key — generate one PER Firebase project:"
    %w[lazervault-dev lazervault-testnet lazervault-28875].each do |proj|
      UI.message "   - #{proj}: https://console.firebase.google.com/project/#{proj}/settings/cloudmessaging/web-push-certs"
    end
    UI.message ""
    UI.message "4. Paste the VAPID key into the corresponding firebase_options_<env>.dart's web config"
    UI.message "   (the FCM JS SDK reads it as vapidKey: in getToken({ vapidKey, serviceWorkerRegistration }))"
    UI.message ""
    UI.message "5. Re-run fastlane dev / staging / production to ship the updated config."
    sh("open https://console.firebase.google.com/project/lazervault-dev/settings/cloudmessaging")
  end

  desc "Dev → TestFlight (internal group) — dev flavor, cloudflared tunnel backend"
  # Builds the dev flavor (points at the cloudflared dev backend) but ships it
  # to TestFlight Internal instead of Firebase App Distribution, so testers run
  # real on-device builds via the same install path as staging/prod. Distribution
  # signing (match app-store) is required — TestFlight rejects development-signed
  # IPAs — which is why this mirrors the staging lane's build path rather than the
  # old `--no-codesign` + development-export Firebase flow.
  lane :dev do |options|
    swap_firebase_plist("dev")
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: asc_api_key) if ENV["MATCH_GIT_URL"]
    # Refresh ios/Flutter/Generated.xcconfig from pubspec (build number/name) so
    # gym picks up the freshly bumped CFBundleVersion — see staging lane for why.
    Dir.chdir(FLUTTER_DIR) { sh("flutter pub get") }
    # `flutter clean` (run before deploys) wipes ios/Pods + the CocoaPods
    # sandbox, but `flutter pub get` does NOT reinstall pods — so gym fails with
    # "The sandbox is not in sync with the Podfile.lock". Reinstall pods here so
    # the Pods sandbox always matches Podfile.lock before the Xcode build.
    # Run OUTSIDE the bundler env: this lane is invoked via `bundle exec`, but
    # CocoaPods is NOT in this Gemfile, so bundler can't resolve the `pod`
    # executable ("can't find executable pod for gem cocoapods"). with_unbundled_env
    # restores the system gem PATH where `pod` is installed.
    Bundler.with_unbundled_env do
      Dir.chdir("#{FLUTTER_DIR}/ios") { sh("pod install") }
    end
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "382F6M9KSZ",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.lazervault.app",
      bundle_identifier: "com.lazervault.app",
      targets: ["Runner"],
    )
    ver_name, ver_build = pubspec_version
    if options[:patch]
      shorebird_patch_ios("dev")
      UI.success("Shorebird OTA patch pushed (dev → TestFlight internal) — no store upload")
      next
    end
    if options[:shorebird]
      shorebird_release_ios("dev", ver_name, ver_build)
      ipa_path = resolve_ipa("build/ios/ipa/Runner-dev.ipa")
    else
      build_app(
        workspace:        WORKSPACE,
        scheme:           SCHEME,
        configuration:    "Release",
        export_method:    "app-store",
        output_directory: "build/ios/ipa",
        output_name:      "Runner-dev.ipa",
        xcargs:           "FLUTTER_BUILD_NAME=#{ver_name} FLUTTER_BUILD_NUMBER=#{ver_build} DART_DEFINES=#{dart_defines_base64('FLAVOR=dev', 'FLUTTER_FLAVOR=dev')} #{COMPRESSION_XCARGS} FLUTTER_BUILD_MODE=release TREE_SHAKE_ICONS=true OBFUSCATE=true SPLIT_DEBUG_INFO=#{FLUTTER_DIR}/build/symbols/ios-dev",
      )
      ipa_path = "build/ios/ipa/Runner-dev.ipa"
    end
    upload_to_testflight(
      api_key:                              asc_api_key,
      ipa:                                  ipa_path,
      skip_waiting_for_build_processing:    true,
      # No `groups:` — internal TestFlight groups (e.g. "Lazervault Admins")
      # AUTO-receive every processed build; the ASC API rejects explicit
      # build→internal-group assignment ("Builds cannot be assigned to this
      # internal group"), which made the lane exit 1 AFTER a successful upload.
      changelog:                            (`git log -1 --pretty=%s`.strip),
    )
  end

  desc "Staging → TestFlight (internal group)"
  lane :staging do |options|
    swap_firebase_plist("staging")
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: asc_api_key) if ENV["MATCH_GIT_URL"]
    # Refresh ios/Flutter/Generated.xcconfig from pubspec (FLUTTER_BUILD_NUMBER,
    # FLUTTER_BUILD_NAME). gym/build_app reads these as Xcode build settings —
    # if they're stale, the IPA gets the OLD CFBundleVersion and ASC rejects
    # the upload with "bundle version already used". `flutter pub get`
    # regenerates the xcconfig from pubspec without triggering the Tahoe
    # codesign issue (which is why we don't use `flutter build ios` here).
    Dir.chdir(FLUTTER_DIR) { sh("flutter pub get") }
    # gym (build_app) triggers xcodebuild archive which invokes Flutter's
    # Run Script Build Phase from within Xcode's environment — sidesteps the
    # Tahoe + Xcode 26 xattr/codesign issue that breaks the standalone
    # `flutter build ios --no-codesign` path. xcargs passes the dart-define
    # through to Flutter's build script.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "382F6M9KSZ",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.lazervault.app",
      bundle_identifier: "com.lazervault.app",
      targets: ["Runner"],
    )
    ver_name, ver_build = pubspec_version
    if options[:patch]
      shorebird_patch_ios("staging")
      UI.success("Shorebird OTA patch pushed (staging → TestFlight internal) — no store upload")
      next
    end
    if options[:shorebird]
      shorebird_release_ios("staging", ver_name, ver_build)
      ipa_path = resolve_ipa("build/ios/ipa/Runner-staging.ipa")
    else
      build_app(
        workspace:        WORKSPACE,
        scheme:           SCHEME,
        configuration:    "Release",
        export_method:    "app-store",
        output_directory: "build/ios/ipa",
        output_name:      "Runner-staging.ipa",
        xcargs:           "FLUTTER_BUILD_NAME=#{ver_name} FLUTTER_BUILD_NUMBER=#{ver_build} DART_DEFINES=#{dart_defines_base64('FLAVOR=staging', 'FLUTTER_FLAVOR=staging')} #{COMPRESSION_XCARGS} FLUTTER_BUILD_MODE=release TREE_SHAKE_ICONS=true OBFUSCATE=true SPLIT_DEBUG_INFO=#{FLUTTER_DIR}/build/symbols/ios-staging",
      )
      ipa_path = "build/ios/ipa/Runner-staging.ipa"
    end
    upload_to_testflight(
      api_key:                              asc_api_key,
      ipa:                                  ipa_path,
      skip_waiting_for_build_processing:    true,
      # No `groups:` — internal groups auto-receive processed builds (see dev lane).
      changelog:                            (`git log -1 --pretty=%s`.strip),
    )
  end

  desc "Production → TestFlight (external) + App Store (no auto-submit)"
  lane :production do |options|
    swap_firebase_plist("prod")
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: asc_api_key) if ENV["MATCH_GIT_URL"]
    if options[:patch]
      shorebird_patch_ios("prod")
      UI.success("Shorebird OTA patch pushed (prod → production) — no store upload")
      next
    end
    ver_name, ver_build = pubspec_version
    if options[:shorebird]
      shorebird_release_ios("prod", ver_name, ver_build)
      ipa_path = resolve_ipa("build/ios/ipa/Runner-prod.ipa")
    else
      flutter("build ios --release --no-codesign --dart-define=FLAVOR=prod --dart-define=FLUTTER_FLAVOR=prod")
      build_app(
        workspace:        WORKSPACE,
        scheme:           SCHEME,
        configuration:    "Release",
        export_method:    "app-store",
        output_directory: "build/ios/ipa",
        output_name:      "Runner-prod.ipa",
        xcargs:           "FLUTTER_BUILD_NAME=#{ver_name} FLUTTER_BUILD_NUMBER=#{ver_build} DART_DEFINES=#{dart_defines_base64('FLAVOR=prod', 'FLUTTER_FLAVOR=prod')} #{COMPRESSION_XCARGS} FLUTTER_BUILD_MODE=release TREE_SHAKE_ICONS=true OBFUSCATE=true SPLIT_DEBUG_INFO=#{FLUTTER_DIR}/build/symbols/ios-prod",
      )
      ipa_path = "build/ios/ipa/Runner-prod.ipa"
    end
    upload_to_testflight(
      api_key:                              asc_api_key,
      ipa:                                  ipa_path,
      skip_waiting_for_build_processing:    true,
      groups:                               ["External"],
      changelog:                            (`git log -1 --pretty=%s`.strip),
    )
    # The binary was ALREADY uploaded by upload_to_testflight above; do NOT
    # re-upload it here (App Store Connect rejects a duplicate build:
    # "bundle version must be higher than the previously uploaded version").
    # skip_binary_upload makes this step only manage the App Store version
    # (points at the already-uploaded build). Review submission stays MANUAL
    # (submit_for_review:false / automatic_release:false).
    upload_to_app_store(
      api_key:             asc_api_key,
      skip_binary_upload:  true,
      submit_for_review:   false,
      automatic_release:   false,
      skip_metadata:       true,
      skip_screenshots:    true,
      force:               true,
    )
  end
end
