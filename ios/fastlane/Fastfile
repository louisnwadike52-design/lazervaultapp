default_platform(:ios)

require "base64"

FLUTTER_DIR = File.expand_path("../..", __dir__) # lazervaultapp/
IOS_DIR     = File.expand_path("..", __dir__)    # lazervaultapp/ios/

# DART_DEFINES expects a base64-encoded comma-separated list of key=value.
# Flutter's Xcode integration script (Run Script Build Phase) reads this env
# var and forwards the values to the Dart kernel-snapshot step.
def dart_defines_base64(*kvs)
  Base64.strict_encode64(kvs.join(","))
end

# Xcode build settings applied to every iOS release build for maximum
# binary size reduction:
#
# DEPLOYMENT_POSTPROCESSING=YES   Triggers post-processing (strip, etc.)
# STRIP_INSTALLED_PRODUCT=YES     Strip symbols from installed binaries
# STRIP_STYLE=all                 Strip every removable symbol (vs. debugging only)
# STRIP_SWIFT_SYMBOLS=YES         Strip Swift module names from the binary
# COPY_PHASE_STRIP=YES            Strip during the copy phase too
# DEAD_CODE_STRIPPING=YES         Linker eliminates unreferenced functions
# LLVM_LTO=YES                    Link-time optimization (cross-module inlining)
# SWIFT_COMPILATION_MODE=wholemodule  Required for LLVM_LTO + better inlining
# SWIFT_OPTIMIZATION_LEVEL=-O     Standard optimization (max for app)
# GCC_OPTIMIZATION_LEVEL=s        Optimize C code for size (-Os)
# ENABLE_BITCODE=NO               Bitcode is deprecated; off everywhere
# VALIDATE_PRODUCT=YES            Strip debug + reject malformed bundles
#
# Apple's App Thinning at install time slices the .ipa per-device so users
# only download what they need (architecture, asset variant, etc.) — these
# settings shrink the master IPA before Apple's slicing kicks in.
# NOTE: the Dart-side switches below are read by Flutter's xcode_backend.dart,
# which looks for DART_OBFUSCATION, SPLIT_DEBUG_INFO, TREE_SHAKE_ICONS and
# CODE_SIZE_DIRECTORY — by those exact names. `OBFUSCATE=true` was passed for
# three lanes and matched nothing, so iOS shipped unobfuscated while Android
# (which passes --obfuscate on the CLI) did not.
COMPRESSION_XCARGS = [
  "DEPLOYMENT_POSTPROCESSING=YES",
  "STRIP_INSTALLED_PRODUCT=YES",
  # STRIP_STYLE=non-global is Apple's recommended setting for App Store
  # distribution — strips debug symbols + local labels but preserves the
  # global symbols SwiftPM packages (webview_flutter_wkwebview,
  # url_launcher_ios, etc.) reference via dynamic linking. STRIP_STYLE=all
  # over-strips these and breaks the archive.
  "STRIP_STYLE=non-global",
  "STRIP_SWIFT_SYMBOLS=YES",
  "COPY_PHASE_STRIP=YES",
  "DEAD_CODE_STRIPPING=YES",
  # LLVM_LTO=YES intermittently breaks compilation of pre-built SPM
  # packages (resource_bundle_accessor.m on GoogleDataTransport hit a
  # frontend crash on Xcode 26 with LTO + Os). Skipped — the size win is
  # smaller than the other strip+optimize flags anyway.
  "SWIFT_COMPILATION_MODE=wholemodule",
  "SWIFT_OPTIMIZATION_LEVEL=-O",
  "GCC_OPTIMIZATION_LEVEL=s",
  "ENABLE_BITCODE=NO",
  "VALIDATE_PRODUCT=YES",
].join(" ")

# Dart side — same compression flags as Android (set in the DART_DEFINES env).
# Flutter's iOS Run Script Build Phase reads these via env vars and forwards
# them to the kernel snapshot step.
COMPRESSION_DART_ENV = {
  "TREE_SHAKE_ICONS"   => "true",
  "SPLIT_DEBUG_INFO"   => "#{FLUTTER_DIR}/build/symbols/ios",
  "OBFUSCATE"          => "true",
}

def flutter(args)
  # Run OUTSIDE the fastlane bundler env. `flutter build ios` shells out to
  # `pod`, but under `bundle exec` the gem-shim `pod` (NOT in this Gemfile)
  # shadows the brew CocoaPods → "can't find executable pod for gem cocoapods"
  # → flutter skips `pod install` → the non-SwiftPM plugins fail to build →
  # `flutter build ios` exits 1. with_unbundled_env restores the system
  # PATH/GEM env so the brew `pod` is used (same fix the pod-install lane uses).
  Bundler.with_unbundled_env do
    Dir.chdir(FLUTTER_DIR) { sh("flutter #{args}") }
  end
end

# --- OTA code-push REMOVED entirely --------------------------------------------
# The OTA code-push helpers (OTA helpers) and the
# code-push_FLUTTER_VERSION constant were deleted. A dev-flavored OTA patch was
# overriding store builds (wrong backend + partial updates). Every lane now does
# a plain gym build that ships the full, self-contained IPA — what you install is
# exactly what runs. Do NOT re-introduce OTA code-push here without an explicit call.

# The .ipa the build just produced. gym honors output_name; OTA code-push may not,
# so fall back to the newest .ipa under build/ios/ipa.
def resolve_ipa(preferred)
  return preferred if File.exist?(File.join(IOS_DIR, preferred)) || File.exist?(preferred)
  newest = Dir.glob(File.join(FLUTTER_DIR, "build/ios/ipa/*.ipa")).max_by { |f| File.mtime(f) }
  newest || UI.user_error!("No .ipa found under build/ios/ipa after the build")
end

def swap_firebase_plist(flavor)
  src = File.join(IOS_DIR, "config", flavor, "GoogleService-Info.plist")
  dst = File.join(IOS_DIR, "Runner", "GoogleService-Info.plist")
  FileUtils.cp(src, dst)
end

def release_notes
  `git -C #{FLUTTER_DIR} log -1 --pretty=%B`.strip
end

# --- Shorebird OTA code-push (iOS) --------------------------------------------
# The Flutter revision Shorebird builds against — MUST match the Android lane's
# SHOREBIRD_FLUTTER_VERSION and the Flutter used by the plain lanes.
SHOREBIRD_FLUTTER_VERSION = "3.44.2".freeze

def ensure_shorebird_on_path
  sb = File.join(Dir.home, ".shorebird", "bin")
  ENV["PATH"] = "#{sb}#{File::PATH_SEPARATOR}#{ENV['PATH']}" unless ENV["PATH"].to_s.split(File::PATH_SEPARATOR).include?(sb)
  UI.user_error!("Shorebird CLI not found at #{sb}/shorebird — install it or add it to PATH") unless File.exist?(File.join(sb, "shorebird"))
end

# Run a shorebird subcommand for iOS from the Flutter project root, with the SAME
# --dart-define flavor wiring the plain lanes use (passed after the `--`
# separator straight through to `flutter build ipa`). shorebird wraps the whole
# archive/export, so codesigning flows through the project's export options as in
# the plain lanes; the produced IPA lands under build/ios/ipa/.
def shorebird_ios(subcommand, flavor)
  ensure_shorebird_on_path
  defines = "--dart-define=FLAVOR=#{flavor} --dart-define=FLUTTER_FLAVOR=#{flavor}"
  Dir.chdir(FLUTTER_DIR) do
    sh("shorebird #{subcommand} ios --flavor #{flavor} " \
       "--flutter-version=#{SHOREBIRD_FLUTTER_VERSION} --no-confirm " \
       "-- #{defines}")
  end
end

# Read "version: x.y.z+BUILD" from pubspec.yaml — the SINGLE source of truth for
# CFBundleShortVersionString (name) and CFBundleVersion (build). Returns
# [name, build] e.g. ["1.0.0", "17"].
#
# Why we pass these explicitly to gym instead of relying on the xcconfig:
# Info.plist resolves CFBundleVersion from $(FLUTTER_BUILD_NUMBER), which lives
# in the git-ignored ios/Flutter/Generated.xcconfig. `flutter pub get` does NOT
# refresh that file, and these lanes build via gym (not `flutter build ios`), so
# the IPA would otherwise archive a STALE build number and TestFlight rejects it
# ("bundle version already used"). Passing FLUTTER_BUILD_NUMBER/NAME on the gym
# xcargs command line overrides the stale xcconfig (command-line build settings
# win over .xcconfig), so the build number always tracks pubspec.
def pubspec_version
  raw = File.read(File.join(FLUTTER_DIR, "pubspec.yaml"))[/^version:\s*(\S+)/, 1]
  UI.user_error!("Could not parse 'version:' from pubspec.yaml") if raw.nil?
  name, build = raw.split("+", 2)
  UI.user_error!("pubspec version '#{raw}' missing +BUILD") if build.nil? || build.empty?
  [name, build]
end

APP_IDENTIFIER  = "com.lazervault.app"
SCHEME          = "Runner"
# Relative to the ios/ dir where fastlane runs (cwd is fastlane/Fastfile's parent).
WORKSPACE       = "Runner.xcworkspace"

# Resolve the App Store Connect API key from the env. The key is the .p8 you
# downloaded from https://appstoreconnect.apple.com/access/api once; we keep
# the actual file out of the repo and reference it by path.
# THE ONLY WAY A BINARY LEAVES THIS MACHINE FOR TESTFLIGHT.
#
# WHY A CHOKE POINT AND NOT A CHECK PER LANE. The first version of this gate
# was a verify_no_private_api() call added to the two lanes being used that
# day. That is the SAME shape of bug as the thing it was guarding: a step you
# have to remember to invoke. Three of the six upload sites were left ungated,
# and the worst of them was testflight_upload_existing — the lane whose entire
# purpose is uploading an IPA built by hand outside the lane system, so it
# never ran `pod install` and never got the source patch either. The one most
# likely to ship the rejected symbol had no check at all.
#
# Routing every upload through here means a new lane cannot forget: there is no
# bare upload_to_testflight left to copy. All six former call sites passed
# identical options apart from `production`'s groups: ["External"], so this is
# a consolidation, not a behaviour change.
def ship_to_testflight(ipa:, groups: nil)
  UI.user_error!('ship_to_testflight needs ipa:') if ipa.nil? || ipa.to_s.strip.empty?
  verify_no_private_api(ipa)
  params = {
    api_key:                           asc_api_key,
    ipa:                               ipa,
    skip_waiting_for_build_processing: true,
    # Do NOT auto-submit for external beta review. That review path runs
    # `precheck`, which CANNOT validate in-app purchases under App-Store-Connect
    # API-key auth and hard-fails the upload. Uploading the binary is enough:
    # internal testers get it immediately; external review can be submitted from
    # App Store Connect when desired. (A valid `pilot` option, unlike
    # `run_precheck_before_submit`, which belongs to `deliver`.)
    submit_beta_review:                false,
    changelog:                         (`git log -1 --pretty=%s`.strip),
  }
  # Omitted, never passed as nil: internal TestFlight groups AUTO-receive every
  # processed build, and the ASC API REJECTS an explicit build->internal-group
  # assignment ("Builds cannot be assigned to this internal group") — which
  # once made a lane exit 1 AFTER a successful upload.
  params[:groups] = groups if groups && !groups.empty?
  upload_to_testflight(params)
end

# FAIL THE RELEASE BEFORE THE UPLOAD, not in review a week later.
#
# scripts/patch_private_api.rb removes the selector from the plugin SOURCES and
# then verifies the SOURCES. Apple rejects the BINARY, and those are different
# claims — the patch runs from the Podfile's post_install, so an archive built
# against an already-installed Pods tree never runs it, a cached framework can
# outlive a source edit, and a prebuilt pod has no source to patch at all.
#
# App Review 2026-10-26 (submission 482b3afb-bd13-4d53-b20b-82161d72de59)
# rejected this app for RPSystemBroadcastPickerView.buttonPressed:, which cost
# a full review cycle. This makes shipping it again impossible rather than
# unlikely.
def verify_no_private_api(ipa_or_archive)
  script = File.join(__dir__, '..', 'scripts', 'verify_no_private_api.rb')
  unless File.exist?(script)
    UI.user_error!("missing #{script} — the private-API binary check cannot be skipped silently")
  end
  # DO NOT GUESS WHERE THE ARTIFACT IS — ASK GYM.
  #
  # I got this wrong twice. gym writes `build/ios/ipa/Runner-*.ipa` relative to
  # the XCODEPROJ directory (ios/), so the file lands at ios/build/ios/ipa/.
  # It is NOT relative to FLUTTER_DIR (lazervaultapp/, where the flutter tool
  # puts its own artifacts) and NOT relative to Dir.pwd, which inside a lane is
  # ios/fastlane/, not ios/. Each wrong guess made this raise "nothing to
  # verify" and abort a build that had genuinely succeeded — a worse failure
  # than the ungated hole the check was added to close, because it breaks every
  # release instead of letting one bad one through.
  #
  # So the FIRST source of truth is gym's own reported output path, which it
  # publishes in lane_context after a successful build_app. The relative
  # candidates below are only for a caller that passes a path by hand
  # (testflight_upload_existing) where no build ran in this process.
  from_gym = lane_context[SharedValues::IPA_OUTPUT_PATH] rescue nil
  candidates = if ipa_or_archive.to_s.start_with?('/')
                 [ipa_or_archive.to_s]
               else
                 [
                   from_gym,
                   # ios/ — the xcodeproj dir, which is what gym resolves against.
                   File.expand_path(ipa_or_archive, File.expand_path('..', __dir__)),
                   File.expand_path(ipa_or_archive, Dir.pwd),
                   File.expand_path(ipa_or_archive, FLUTTER_DIR)
                 ].compact
               end
  path = candidates.find { |c| File.exist?(c) }
  if path.nil?
    UI.user_error!(<<~MSG)
      nothing to verify — no build artifact at any of:
      #{candidates.map { |c| "  #{c}" }.join("\n")}
      The private-API check cannot be skipped, so this is a hard stop. If the
      build genuinely succeeded, the output path moved and this resolution
      needs updating.
    MSG
  end
  # Non-zero exit = the rejected symbol is in the binary. Hard stop: the whole
  # point is that no upload happens after this returns false.
  unless system('ruby', script, path)
    UI.user_error!(<<~MSG)
      A rejected private API is present in the built binary — upload ABORTED.
      Output above names the file and the selector.
        cd ios && pod install && <rebuild>
    MSG
  end
end

def asc_api_key
  key_id     = ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id  = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_path   = ENV["APP_STORE_CONNECT_KEY_PATH"] || \
               File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  unless key_id && issuer_id && File.exist?(key_path)
    UI.user_error!(<<~MSG)
      App Store Connect API key not configured. Set in your shell:
        export APP_STORE_CONNECT_KEY_ID="XXXXXXXXXX"          # 10-char Key ID
        export APP_STORE_CONNECT_ISSUER_ID="xxxxxxxx-..."     # UUID from ASC → Keys
        export APP_STORE_CONNECT_KEY_PATH="/abs/path/AuthKey_XXXXXXXXXX.p8"
      Then run `fastlane setup_appstore` to verify.
    MSG
  end
  app_store_connect_api_key(
    key_id:      key_id,
    issuer_id:   issuer_id,
    key_filepath: key_path,
    duration:    1200,
    in_house:    false,
  )
end

platform :ios do
  desc "FIRST-TIME SETUP — verifies App Store Connect access, auto-creates the app listing if missing"
  lane :setup_appstore do
    key = asc_api_key
    UI.header "Verifying App Store Connect access for #{APP_IDENTIFIER}"

    # Try to fetch the latest build number — both proves auth AND proves the
    # App Store Connect listing exists. Returns 0 when it exists but has no
    # builds (the expected first-run state).
    begin
      build_num = latest_testflight_build_number(
        api_key:              key,
        app_identifier:       APP_IDENTIFIER,
        initial_build_number: 0,
      )
      UI.success "✅ ASC API key valid"
      UI.success "✅ App row found for #{APP_IDENTIFIER}"
      UI.message "   Latest TestFlight build number: #{build_num} #{build_num == 0 ? '(no builds uploaded yet)' : ''}"
    rescue => e
      UI.important "App row NOT found on App Store Connect — running `produce` to create it."
      UI.important "(Bundle ID is registered in Apple Developer Portal, but the App Store"
      UI.important " listing is a separate Apple resource that must exist before TestFlight"
      UI.important " uploads work. produce is the canonical fastlane way to create it.)"
      produce(
        api_key:        key,
        app_identifier: APP_IDENTIFIER,
        app_name:       "Lazervault",
        language:       "English",
        app_version:    "1.0",
        sku:            "LAZERVAULT_IOS_001",
        # Don't try to register the bundle id with the dev portal — the user
        # already did that manually. Only create the App Store Connect row.
        skip_itc:       false,
        skip_devcenter: true,
      )
      UI.success "✅ App listing created on App Store Connect"
    end

    UI.message ""
    UI.message "Next steps in order:"
    UI.message "  1. bundle exec fastlane sync_signing      # match — pulls/creates distribution certs"
    UI.message "  2. bundle exec fastlane beta              # build + upload to TestFlight internal"
    UI.message "  3. bundle exec fastlane production        # full release lane"
  end

  desc "Sync iOS code-signing via fastlane match. Run once on this machine."
  # `force: true` REGENERATES the provisioning profile instead of reusing the
  # stored one. Needed when a capability is enabled on the App ID AFTER the
  # profile was issued: a profile is a snapshot of the App ID's capabilities at
  # issue time, so the stored one stays stale forever and exportArchive keeps
  # refusing. That is what happened with NFC — the profile dated 9 Sep 2026 and
  # NFC_TAG_READING was turned on later, so every build failed with
  # "doesn't include the NFC Tag Reading capability" while the App ID had it.
  #
  # It regenerates the PROFILE only. The distribution CERTIFICATE is pulled
  # from the match repo, not reissued, so no other machine's signing identity
  # is revoked — that is `match nuke`, not this.
  #
  #   bundle exec fastlane sync_signing force:true
  lane :sync_signing do |options|
    unless ENV["MATCH_GIT_URL"]
      UI.user_error!(<<~MSG)
        MATCH_GIT_URL not set. fastlane match stores certs/profiles in a
        private git repo so any dev/CI box can pull them.
        Quick start:
          gh repo create lazervault/ios-certs --private --confirm
          export MATCH_GIT_URL="git@github.com:lazervault/ios-certs.git"
          export MATCH_PASSWORD="<a strong password — needed to decrypt>"
        Then re-run this lane.
      MSG
    end
    # api_key is NOT optional. Without it match falls back to Apple-ID
    # (spaceship) auth and dies with "Missing username, and running in
    # non-interactive shell" — which is also why `fastlane match appstore` must
    # never be called straight from the CLI here. Every lane in this file goes
    # through asc_api_key for the same reason.
    match(
      type: "appstore",
      app_identifier: [APP_IDENTIFIER],
      readonly: false,  # first run; flip to true on CI
      force: options[:force] ? true : false,
      api_key: asc_api_key,
    )
  end

  desc "READ-ONLY: what build does TestFlight actually hold for a version?"
  # Answers "did the upload land?" without shipping anything.
  #
  # `fastlane run latest_testflight_build_number` on its own fails with
  # "No value found for 'username'": the bare runner has no api_key object, so
  # it falls back to Apple-ID auth and asks for a login we cannot complete
  # under an App Store Connect API key. A lane can pass asc_api_key, so this
  # exists purely to make that read possible.
  #
  #   bundle exec fastlane tf_status version:1.0.1
  lane :tf_status do |options|
    version = options[:version]
    build = latest_testflight_build_number(
      api_key:        asc_api_key,
      app_identifier: APP_IDENTIFIER,
      version:        version,
    )
    UI.success("TestFlight latest build for #{version || 'the newest version'}: #{build}")
  end

  desc "What App Store Connect says RIGHT NOW: Apple ID, review state, and the build under review"
  lane :review_status do
    # Why this lane exists: nothing in this repo could answer "is it in review,
    # since when, and with which build". `tf_status` reports the latest
    # TestFlight build, which is a different question — a build can sit in
    # TestFlight for days while no App Store version has ever been submitted,
    # and every lane here uploads with submit_for_review:false, so submission is
    # always a manual act in App Store Connect that leaves no trace locally.
    # NOT `Spaceship::ConnectAPI.login(api_key: ...)` — that signature does not
    # exist. `login` is the Apple-ID path, `login(user, password, use_portal:,
    # use_tunes:, ...)`, and it rejects the keyword outright with
    # "unknown keyword: :api_key". That is how this lane came to be broken on
    # fastlane 2.236.1 while every other lane kept working: the others pass
    # api_key to an ACTION (upload_to_testflight, latest_testflight_build_number),
    # where it IS a valid option. Spaceship itself is authorized by a token.
    #
    # `app_store_connect_api_key` already sets Spaceship::ConnectAPI.token as a
    # side effect (set_spaceship_token defaults to true), so the reads below
    # would work without this line. It is set explicitly anyway: a read-only
    # diagnostic should not silently stop working because an upstream default
    # flipped, and this lane exists to be trusted at the moment someone is
    # asking whether a submission is at risk.
    api_key = asc_api_key
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**api_key)

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    if app.nil?
      UI.user_error!("No App Store Connect app row for #{APP_IDENTIFIER}. " \
                     "Run `fastlane setup_appstore` first.")
    end

    UI.header "App Store Connect — #{APP_IDENTIFIER}"
    UI.success "Apple ID (app id) : #{app.id}"
    UI.message "Name              : #{app.name}"
    UI.message "SKU               : #{app.sku}"
    UI.message "Primary locale    : #{app.primary_locale}"
    UI.message "Bundle ID         : #{app.bundle_id}"

    # Every App Store version, newest first, with the state Apple is actually
    # reporting. PREPARE_FOR_SUBMISSION means it was NEVER submitted — which is
    # the answer that matters most if someone believes it has been in review.
    versions = begin
      app.get_app_store_versions(
        includes: "build,appStoreVersionSubmission",
        limit: 10,
      )
    rescue => e
      UI.important "Could not list App Store versions: #{e.message}"
      []
    end

    if versions.empty?
      UI.important "No App Store version records at all — nothing has ever been submitted."
    else
      UI.header "App Store versions"
      versions.each do |v|
        build_no = begin
          v.build&.version
        rescue
          nil
        end
        submitted = begin
          v.app_store_version_submission ? "yes" : "no"
        rescue
          "unknown"
        end
        UI.message "  #{v.version_string.to_s.ljust(10)} " \
                   "state=#{v.app_store_state.to_s.ljust(26)} " \
                   "build=#{(build_no || '—').to_s.ljust(6)} " \
                   "submitted=#{submitted} " \
                   "created=#{v.created_date}"
      end
      live = versions.find { |v| v.app_store_state.to_s == "READY_FOR_SALE" }
      UI.success "Live on the App Store: #{live ? live.version_string : 'not yet released'}"
    end

    # The TestFlight side, for contrast: a build here is NOT a submission.
    tf = begin
      latest_testflight_build_number(api_key: api_key, app_identifier: APP_IDENTIFIER)
    rescue => e
      UI.important "TestFlight lookup failed: #{e.message}"
      nil
    end
    UI.message "Latest TestFlight build: #{tf || 'unknown'}"
    UI.important "A TestFlight build is not an App Store submission. If every version " \
                 "above reads PREPARE_FOR_SUBMISSION, the app is NOT in review."
  end

  desc "Upload an existing IPA to TestFlight (skips rebuild). Useful when manually built in Xcode."
  lane :testflight_upload_existing do |options|
    ipa = options[:ipa] || UI.user_error!("Pass ipa:'<path>' to this lane")
    ship_to_testflight(ipa: ipa)
  end

  desc "Quick alias for the staging lane (TestFlight internal group)"
  lane :beta do
    staging
  end

  desc "Open Firebase Console pages for the APNs .p8 + VAPID upload (one-time setup)"
  lane :setup_push_credentials do
    UI.header "APNs + Web Push setup (one-time, per Firebase project)"
    UI.message "1. Apple Developer Console → Keys → '+' → enable 'Apple Push Notifications service (APNs)' → download .p8"
    UI.message "   https://developer.apple.com/account/resources/authkeys/list"
    UI.message ""
    UI.message "2. Upload that .p8 to EACH Firebase project (one per env):"
    %w[lazervault-dev lazervault-testnet lazervault-28875].each do |proj|
      UI.message "   - #{proj}: https://console.firebase.google.com/project/#{proj}/settings/cloudmessaging"
    end
    UI.message ""
    UI.message "3. Web Push VAPID key — generate one PER Firebase project:"
    %w[lazervault-dev lazervault-testnet lazervault-28875].each do |proj|
      UI.message "   - #{proj}: https://console.firebase.google.com/project/#{proj}/settings/cloudmessaging/web-push-certs"
    end
    UI.message ""
    UI.message "4. Paste the VAPID key into the corresponding firebase_options_<env>.dart's web config"
    UI.message "   (the FCM JS SDK reads it as vapidKey: in getToken({ vapidKey, serviceWorkerRegistration }))"
    UI.message ""
    UI.message "5. Re-run fastlane dev / staging / production to ship the updated config."
    sh("open https://console.firebase.google.com/project/lazervault-dev/settings/cloudmessaging")
  end

  desc "Dev → TestFlight internal track (PROD build: prod backend/Firebase)"
  # Ships the PROD tier (FLUTTER_FLAVOR=prod → api.lazervault.app, compiled in;
  # prod GoogleService-Info.plist) to the TestFlight INTERNAL track. The lane name
  # selects the TRACK, not the backend — internal testers exercise the REAL prod
  # backend + Firebase, same as external/production. (Was previously FLAVOR=dev +
  # dev plist, which silently pointed internal TestFlight at the dev backend — a
  # dev user could sign in.) iOS has no Xcode flavor schemes, so the tier is set
  # purely via DART_DEFINES + this plist swap; SCHEME stays "Runner".
  lane :dev do |options|
    swap_firebase_plist("prod")
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: asc_api_key) if ENV["MATCH_GIT_URL"]
    # Refresh ios/Flutter/Generated.xcconfig from pubspec (build number/name) so
    # gym picks up the freshly bumped CFBundleVersion — see staging lane for why.
    Dir.chdir(FLUTTER_DIR) { sh("flutter pub get") }
    # `flutter clean` (run before deploys) wipes ios/Pods + the CocoaPods
    # sandbox, but `flutter pub get` does NOT reinstall pods — so gym fails with
    # "The sandbox is not in sync with the Podfile.lock". Reinstall pods here so
    # the Pods sandbox always matches Podfile.lock before the Xcode build.
    # Run OUTSIDE the bundler env: this lane is invoked via `bundle exec`, but
    # CocoaPods is NOT in this Gemfile, so bundler can't resolve the `pod`
    # executable ("can't find executable pod for gem cocoapods"). with_unbundled_env
    # restores the system gem PATH where `pod` is installed.
    Bundler.with_unbundled_env do
      Dir.chdir("#{FLUTTER_DIR}/ios") { sh("pod install") }
    end
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "382F6M9KSZ",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.lazervault.app",
      bundle_identifier: "com.lazervault.app",
      targets: ["Runner"],
    )
    ver_name, ver_build = pubspec_version
    # OTA code-push REMOVED — always a plain gym build (no OTA code-push).
    build_app(
      workspace:        WORKSPACE,
      scheme:           SCHEME,
      configuration:    "Release",
      clean:            true,
      export_method:    "app-store",
      output_directory: "build/ios/ipa",
      output_name:      "Runner-dev.ipa",
      xcargs:           "FLUTTER_BUILD_NAME=#{ver_name} FLUTTER_BUILD_NUMBER=#{ver_build} DART_DEFINES=#{dart_defines_base64('FLAVOR=prod', 'FLUTTER_FLAVOR=prod')} #{COMPRESSION_XCARGS} FLUTTER_BUILD_MODE=release TREE_SHAKE_ICONS=true DART_OBFUSCATION=true SPLIT_DEBUG_INFO=#{FLUTTER_DIR}/build/symbols/ios-prod",
    )
    ipa_path = "build/ios/ipa/Runner-dev.ipa"
    ship_to_testflight(ipa: ipa_path)
  end

  desc "Staging → TestFlight internal track (PROD build: prod backend/Firebase)"
  # Same as the dev lane but a distinct entrypoint for the alpha/staging cadence:
  # ships the PROD tier (prod backend + Firebase) to TestFlight internal. iOS has
  # no flavor schemes, so tier = DART_DEFINES + plist swap; SCHEME stays "Runner".
  lane :staging do |options|
    swap_firebase_plist("prod")
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: asc_api_key) if ENV["MATCH_GIT_URL"]
    # Refresh ios/Flutter/Generated.xcconfig from pubspec (FLUTTER_BUILD_NUMBER,
    # FLUTTER_BUILD_NAME). gym/build_app reads these as Xcode build settings —
    # if they're stale, the IPA gets the OLD CFBundleVersion and ASC rejects
    # the upload with "bundle version already used". `flutter pub get`
    # regenerates the xcconfig from pubspec without triggering the Tahoe
    # codesign issue (which is why we don't use `flutter build ios` here).
    Dir.chdir(FLUTTER_DIR) { sh("flutter pub get") }
    # gym (build_app) triggers xcodebuild archive which invokes Flutter's
    # Run Script Build Phase from within Xcode's environment — sidesteps the
    # Tahoe + Xcode 26 xattr/codesign issue that breaks the standalone
    # `flutter build ios --no-codesign` path. xcargs passes the dart-define
    # through to Flutter's build script.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "382F6M9KSZ",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore com.lazervault.app",
      bundle_identifier: "com.lazervault.app",
      targets: ["Runner"],
    )
    ver_name, ver_build = pubspec_version
    # OTA code-push REMOVED — always a plain gym build (no OTA code-push).
    build_app(
      workspace:        WORKSPACE,
      scheme:           SCHEME,
      configuration:    "Release",
      clean:            true,
      export_method:    "app-store",
      output_directory: "build/ios/ipa",
      output_name:      "Runner-staging.ipa",
      xcargs:           "FLUTTER_BUILD_NAME=#{ver_name} FLUTTER_BUILD_NUMBER=#{ver_build} DART_DEFINES=#{dart_defines_base64('FLAVOR=prod', 'FLUTTER_FLAVOR=prod')} #{COMPRESSION_XCARGS} FLUTTER_BUILD_MODE=release TREE_SHAKE_ICONS=true DART_OBFUSCATION=true SPLIT_DEBUG_INFO=#{FLUTTER_DIR}/build/symbols/ios-prod",
    )
    ipa_path = "build/ios/ipa/Runner-staging.ipa"
    ship_to_testflight(ipa: ipa_path)
  end

  # The prod IPA build, shared by :production and :prod_internal so the two
  # cannot drift. Extracted verbatim from :production — same flutter
  # invocation, same gym args (obfuscation, split debug info, tree-shaken
  # icons, compression), same output path. Returns the IPA path.
  #
  # It exists because the only difference between shipping to external testers
  # and shipping to internal ones is the UPLOAD, and duplicating this xcargs
  # string to express that is how a build flag silently stops matching between
  # the two tracks.
  private_lane :build_prod_ipa do
    ver_name, ver_build = pubspec_version
    # OTA code-push REMOVED — always a plain gym build (no OTA code-push).
    flutter("build ios --release --no-codesign --dart-define=FLAVOR=prod --dart-define=FLUTTER_FLAVOR=prod")
    build_app(
      workspace:        WORKSPACE,
      scheme:           SCHEME,
      configuration:    "Release",
      clean:            true,
      export_method:    "app-store",
      output_directory: "build/ios/ipa",
      output_name:      "Runner-prod.ipa",
      xcargs:           "FLUTTER_BUILD_NAME=#{ver_name} FLUTTER_BUILD_NUMBER=#{ver_build} DART_DEFINES=#{dart_defines_base64('FLAVOR=prod', 'FLUTTER_FLAVOR=prod')} #{COMPRESSION_XCARGS} FLUTTER_BUILD_MODE=release TREE_SHAKE_ICONS=true DART_OBFUSCATION=true SPLIT_DEBUG_INFO=#{FLUTTER_DIR}/build/symbols/ios-prod",
    )
    ipa = "build/ios/ipa/Runner-prod.ipa"
    ipa
  end

  desc "Production build → TestFlight INTERNAL testers only (no App Store version)"
  # The prod BACKEND on the INTERNAL track — which is what the operator asks
  # for, and which neither existing lane does:
  #
  #   :staging     internal track, but the STAGING backend;
  #   :production  the prod backend, but adds the build to the EXTERNAL group
  #                AND creates/points an App Store version at it.
  #
  # Neither extra step is a public release (submit_beta_review and
  # submit_for_review are both false), but both reach further than "internal
  # testing" and should be a deliberate choice, not a side effect of wanting a
  # prod-env test build.
  lane :prod_internal do
    swap_firebase_plist("prod")
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: asc_api_key) if ENV["MATCH_GIT_URL"]
    ship_to_testflight(ipa: build_prod_ipa)
  end

  desc "Production → TestFlight (external) + App Store (no auto-submit)"
  lane :production do |options|
    swap_firebase_plist("prod")
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: asc_api_key) if ENV["MATCH_GIT_URL"]
    ipa_path = build_prod_ipa
    # EXTERNAL testers. The only upload in this file that is not
    # internal-only, and the reason ship_to_testflight takes a groups:
    # option at all.
    ship_to_testflight(ipa: ipa_path, groups: ["External"])
    # The binary was ALREADY uploaded by upload_to_testflight above; do NOT
    # re-upload it here (App Store Connect rejects a duplicate build:
    # "bundle version must be higher than the previously uploaded version").
    # skip_binary_upload makes this step only manage the App Store version
    # (points at the already-uploaded build). Review submission stays MANUAL
    # (submit_for_review:false / automatic_release:false).
    upload_to_app_store(
      api_key:             asc_api_key,
      skip_binary_upload:  true,
      submit_for_review:   false,
      automatic_release:   false,
      skip_metadata:       true,
      skip_screenshots:    true,
      force:               true,
      # Disable precheck: under App-Store-Connect API-key auth it CANNOT validate
      # in-app purchases and hard-fails with "Precheck cannot check In-app
      # purchases with the App Store Connect API Key" (this crashed build 187's
      # production lane). We only manage the App Store version here and keep
      # review submission MANUAL, so precheck adds nothing but the failure.
      run_precheck_before_submit: false,
    )
  end

  # --- Shorebird OTA code-push lanes (additive; plain lanes above are unchanged)
  # ONLY invoked via the --shorebird / --patch deploy flags. They do NOT replace
  # the normal build lanes — a plain deploy never calls them.
  #
  # shorebird_release: builds a PATCH-CAPABLE release IPA (ships as a normal new
  #   build to TestFlight, but is now patchable via `shorebird patch`). Tier is set
  #   the same way the plain lanes set it — swap_firebase_plist + the FLAVOR
  #   dart-defines — so a shorebird prod build points at the prod backend/Firebase
  #   exactly like `production`.
  desc "Shorebird patch-capable RELEASE (IPA) → TestFlight internal"
  lane :shorebird_release do |options|
    flavor = (options[:flavor] || "prod").to_s
    swap_firebase_plist(flavor)
    setup_ci if ENV["CI"]
    match(type: "appstore", readonly: true, api_key: asc_api_key) if ENV["MATCH_GIT_URL"]
    shorebird_ios("release", flavor)
    ipa_path = resolve_ipa("build/ios/ipa/Runner-#{flavor}.ipa")
    UI.user_error!("Shorebird iOS release produced no IPA") unless ipa_path && File.exist?(ipa_path.start_with?("/") ? ipa_path : File.join(FLUTTER_DIR, ipa_path))
    UI.success("Built patch-capable IPA: #{ipa_path}")
    ship_to_testflight(ipa: ipa_path)
  end

  # shorebird_patch: pushes a Dart-only OTA PATCH to the already-shipped release
  #   for this flavor. NO version bump, NO store upload — live on devices in
  #   minutes. Requires a prior shorebird_release for the same flavor to target.
  desc "Shorebird OTA PATCH (Dart-only) → already-shipped iOS release (no store, no bump)"
  lane :shorebird_patch do |options|
    flavor = (options[:flavor] || "prod").to_s
    swap_firebase_plist(flavor)
    shorebird_ios("patch", flavor)
    UI.success("Shorebird OTA patch pushed for iOS flavor=#{flavor} (no store upload, no build bump)")
  end
end
