#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables
.env
.env.*
.env.local
*.env
# Generated proto files
**/pb/

# Portable signing/deploy credentials (keystores, ASC/APNs .p8, SA JSON).
# In-repo for device portability; MUST NEVER be committed.
credentials/

# --- security: never commit secrets / env / keys / venvs (added 2026-08) ---
.env
.env.*
!.env.example
!.env.sample
!.env.template
!*.example
!*.sample
!*.template
*.pem
*.p12
*.jks
*.keystore
keys/*.pem
secrets/
service-account*.json
*-key.json
venv/
.venv/
__pycache__/
*.pyc
ios/build/

# Finder/iCloud duplicate artifacts ("name 2.ext"). The space defeats patterns
# like `.env.*`, so a duplicate of an ignored file is NOT ignored — that is how
# `android/.env 2.firebase` and a stray `pubspec 2.yaml` got committed.
.env *
* 2.*
* [0-9].*
