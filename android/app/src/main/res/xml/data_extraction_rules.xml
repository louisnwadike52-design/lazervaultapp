<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (android:dataExtractionRules). Same exclusions as
  backup_rules.xml, applied to both transports:

    cloud-backup   — Google Drive backup/restore
    device-transfer — direct phone-to-phone migration

  Both must exclude the device id. A device-transfer in particular looks
  benign, but carrying the identity to a new handset is exactly how a new
  device would arrive already trusted. See backup_rules.xml for the reasoning.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
