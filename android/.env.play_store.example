# LazerVault Android — Play Console + Firebase env contract.
# Copy to .env.play_store (gitignored) and fill in real values.
# Source via scripts/deploy_mobile.sh — the script auto-loads this file.
#
# Same env vars are read by .github/workflows/mobile-deploy.yml, so the
# lane behaviour is identical whether you run locally or via CI.

# ----------------------------------------------------------------------------
# Google Play Console — required for `dev / staging / production` lanes
# ----------------------------------------------------------------------------
# To create the JSON:
#   1. https://play.google.com/console → Settings → Developer account → API access
#   2. Click "Create new service account" (opens Google Cloud)
#   3. In Google Cloud → IAM → Service Accounts → Create
#      Name: lazervault-play-console
#      Grant role: none (Play Console grants its own)
#   4. Back in Play Console → grant the SA access:
#      Role: Release manager
#      Permissions: All apps + Create + edit + publish
#   5. Click "..." next to the SA → Manage keys → Create new key → JSON
#   6. Download, save to ~/.appstoreconnect/play_store/play-store-sa.json
#   7. chmod 600 the file
export PLAY_STORE_JSON_KEY="$HOME/.appstoreconnect/play_store/play-store-sa.json"

# ----------------------------------------------------------------------------
# Firebase App Distribution — fallback path for `dev_firebase` lane
# ----------------------------------------------------------------------------
# Reuses one of the FCM service-account JSONs from notifications-service's
# secrets/ directory. The SA needs roles/firebaseappdistro.admin (already
# granted in this session on all 3 Firebase projects).
export FIREBASE_SERVICE_ACCOUNT_JSON="$(cd ../.. && pwd)/microservices/notifications-service/notifications-microservice/secrets/fcm-dev.json"

# Optional Firebase tester groups for auto-distribution. Leave empty (or
# unset) to upload the build without auto-distributing — testers can be
# added manually in Firebase Console after the upload. The internal-testers
# group exists in all 3 Firebase projects (created via REST in this session).
export FAD_GROUPS="internal-testers"

# Legacy fallback only — leave empty if FIREBASE_SERVICE_ACCOUNT_JSON is set.
export FIREBASE_TOKEN=""
