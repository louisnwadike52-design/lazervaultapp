default_platform(:android)

FLUTTER_DIR = File.expand_path("../..", __dir__) # lazervaultapp/

def flutter(args)
  Dir.chdir(FLUTTER_DIR) { sh("flutter #{args}") }
end

def aab_for(flavor)
  File.join(FLUTTER_DIR,
    "build/app/outputs/bundle/#{flavor}Release/app-#{flavor}-release.aab")
end

def apk_for(flavor)
  File.join(FLUTTER_DIR,
    "build/app/outputs/flutter-apk/app-#{flavor}-release.apk")
end

def release_notes
  `git -C #{FLUTTER_DIR} log -1 --pretty=%B`.strip
end

platform :android do
  desc "Dev → Firebase App Distribution (internal testers)"
  # Builds an APK (not AAB). Firebase App Distribution requires either an APK,
  # OR an AAB on a Firebase project linked to a Play Developer account.
  # Linking to Play is only worthwhile for production releases — dev builds
  # stay APK so any tester device can install directly.
  #
  # `groups:` is only sent when FAD_GROUPS is set in the env to a group that
  # actually exists in the Firebase project. Firebase rejects the whole
  # distribution call with "HALTED release must have fraction" if the named
  # group doesn't exist yet. Without it, the release uploads cleanly to
  # Console where testers can be added manually.
  lane :dev do
    flutter("build apk --flavor dev --dart-define=FLAVOR=dev --release")
    args = {
      app: "1:961906506476:android:ec73b0375c4900043843c9",
      android_artifact_type: "APK",
      android_artifact_path: apk_for("dev"),
      release_notes: release_notes,
      service_credentials_file: ENV["FIREBASE_SERVICE_ACCOUNT_JSON"],
      firebase_cli_token: ENV["FIREBASE_TOKEN"],
    }
    args[:groups] = ENV["FAD_GROUPS"] if ENV["FAD_GROUPS"] && !ENV["FAD_GROUPS"].empty?
    firebase_app_distribution(args)
  end

  desc "Staging → Play Store internal track"
  lane :staging do
    flutter("build appbundle --flavor staging --dart-define=FLAVOR=staging")
    upload_to_play_store(
      track: "internal",
      aab: aab_for("staging"),
      json_key: ENV["PLAY_STORE_JSON_KEY"],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft",
    )
  end

  desc "Production → Play Store production track"
  lane :production do
    flutter("build appbundle --flavor prod --dart-define=FLAVOR=prod")
    upload_to_play_store(
      track: "production",
      aab: aab_for("prod"),
      json_key: ENV["PLAY_STORE_JSON_KEY"],
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed",
    )
  end
end
