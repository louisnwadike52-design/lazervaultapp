default_platform(:android)

FLUTTER_DIR = File.expand_path("../..", __dir__) # lazervaultapp/

def flutter(args)
  Dir.chdir(FLUTTER_DIR) { sh("flutter #{args}") }
end

# --- Durable env-file strategy + OTA code-push release --------------------------
require "fileutils"
require "shellwords"
require "tmpdir"

# Locate an NDK `llvm-readelf` (any installed NDK / host works — we only read
# section headers). Used to PROVE an AAB's native libs are stripped.
def ndk_readelf
  sdk = ENV["ANDROID_HOME"] || ENV["ANDROID_SDK_ROOT"] ||
        File.join(Dir.home, "Library/Android/sdk")
  Dir.glob(File.join(sdk, "ndk/*/toolchains/llvm/prebuilt/*/bin/llvm-readelf")).sort.last
end

# True IFF the built AAB exists AND every base/lib/<abi>/libapp.so it contains
# carries NO DWARF debug sections (i.e. gradle already stripped them).
#
# Why this exists: on this toolchain (Android build-tools 37 / cmdline-tools
# emitting "SDK XML v4"), `flutter build appbundle` PRODUCES a correct,
# fully-stripped, R8-shrunk AAB and THEN a spurious post-build check prints
# "Release app bundle failed to strip debug symbols from native libraries" and
# exits non-zero — aborting the deploy before upload. This lets the lane
# distinguish that false alarm (AAB present + verifiably stripped → proceed)
# from a genuine build failure (AAB absent or libs still carry DWARF → re-raise).
def aab_native_libs_stripped?(flavor)
  aab = aab_for(flavor)
  return false unless File.exist?(aab)
  readelf = ndk_readelf
  return false unless readelf && File.exist?(readelf)
  Dir.mktmpdir do |dir|
    system("unzip", "-qo", aab, "base/lib/*/libapp.so", "-d", dir)
    libs = Dir.glob(File.join(dir, "base/lib/*/libapp.so"))
    return false if libs.empty?
    libs.all? do |lib|
      out = `#{readelf.shellescape} --section-headers #{lib.shellescape} 2>/dev/null`
      !out.match?(/\.debug_|\.dwarf/)
    end
  end
end

# `.env` is a bundled Flutter asset (pubspec assets: - .env), so the backend
# config is baked in at BUILD time. Rule (per ops): every STORE build
# (internal/alpha/prod tracks) ships .env.prod; only the emulator uses .env.dev
# (see scripts/run_app_emulator.sh). Call this at the top of every store lane.
def use_env(name)
  src = File.join(FLUTTER_DIR, ".env.#{name}")
  UI.user_error!("env source missing: #{src}") unless File.exist?(src)
  FileUtils.cp(src, File.join(FLUTTER_DIR, ".env"))
  UI.message("env: .env <- .env.#{name} (build will bundle #{name} backend config)")
end

# OTA code-push REMOVED entirely (helpers + constants deleted). Store builds ship
# full binaries only — no OTA code-push, no per-flavor OTA code-push app_ids.

# Build the release AAB via a plain, full flutter build.
# ONLY when opted in via --code-push (options[:code-push]); otherwise a plain
# flutter build so normal CI/deploys never touch OTA code-push.
def build_release_aab(flavor, _unused = nil)
  # OTA code-push REMOVED — always a plain, full `flutter build` (no OTA code-push).
  # A code-push patch was overriding store builds with a dev-flavored bundle.
  begin
    flutter("build appbundle --flavor #{flavor} --dart-define=FLAVOR=#{flavor} --dart-define=FLUTTER_FLAVOR=#{flavor} #{COMPRESSION_FLAGS}")
  rescue => e
    # `flutter build` can exit non-zero on a SPURIOUS post-build native-strip
    # check even after gradle produced a correct, fully-stripped AAB (see
    # aab_native_libs_stripped?). Swallow that false alarm ONLY when the AAB is
    # present and its native libs are verifiably DWARF-free; otherwise the
    # failure is real → re-raise so the deploy aborts.
    raise e unless aab_native_libs_stripped?(flavor)
    UI.important("flutter build exited non-zero on the post-build strip check, " \
                 "but the AAB is present and its native libs are verified " \
                 "stripped (0 DWARF sections) — treating as success.")
  end
end

# Flutter compression flags applied to every release build:
#
# --release                  Standard release mode (AOT compile, no debug
#                            assertions, tree-shaking, etc.)
# --tree-shake-icons         Strip unused glyphs from the MaterialIcons font.
#                            Typically saves 1.5 MB on the icon font alone.
# --obfuscate                Apply Dart name obfuscation to release symbols.
#                            Smaller AOT binary + makes reverse engineering
#                            harder. Pair with --split-debug-info so we can
#                            still symbolicate crash reports.
# --split-debug-info=DIR     Strip debug info from the AOT binary and write
#                            it to DIR. The binary shrinks by ~30%. Keep the
#                            DIR (per build) so crash reports stay
#                            symbolicatable via flutter symbolize.
# --shrink                   (Android only) tells Gradle to use R8 + resource
#                            shrinker (we also enable these in build.gradle.kts,
#                            this is the Flutter side of the same switch).
COMPRESSION_FLAGS = "--release --tree-shake-icons --obfuscate --split-debug-info=#{FLUTTER_DIR}/build/symbols/android --shrink"

def aab_for(flavor)
  File.join(FLUTTER_DIR,
    "build/app/outputs/bundle/#{flavor}Release/app-#{flavor}-release.aab")
end

# Delete the exact artifact upload_to_play_store will point at (and the flavor's
# whole bundle output dir) BEFORE building. Without this the AAB path persists
# between runs, so any short-circuited/partial build could ship a stale AAB to
# the internal track — the "Android isn't showing the latest update" bug. After
# this, the uploaded file is guaranteed to have been written by THIS run (or the
# lane fails loudly because the file is absent).
def purge_stale_aab(flavor)
  require "fileutils"
  FileUtils.rm_rf(File.join(FLUTTER_DIR, "build/app/outputs/bundle/#{flavor}Release"))
  FileUtils.rm_f(aab_for(flavor))
end

def apk_for(flavor, build_type = "release")
  File.join(FLUTTER_DIR,
    "build/app/outputs/flutter-apk/app-#{flavor}-#{build_type}.apk")
end

def apk_arm64_for(flavor, build_type = "debug")
  File.join(FLUTTER_DIR,
    "build/app/outputs/flutter-apk/app-arm64-v8a-#{flavor}-#{build_type}.apk")
end

def release_notes
  `git -C #{FLUTTER_DIR} log -1 --pretty=%B`.strip
end

# --- Shorebird OTA code-push (flag-gated, additive) -----------------------------
# The Shorebird CLI is installed under ~/.shorebird/bin but is NOT on PATH by
# default. Prepend it (idempotently) so `shorebird` resolves inside the lane.
def ensure_shorebird_on_path
  sb = File.join(Dir.home, ".shorebird", "bin")
  ENV["PATH"] = "#{sb}#{File::PATH_SEPARATOR}#{ENV['PATH']}" unless ENV["PATH"].to_s.split(File::PATH_SEPARATOR).include?(sb)
  UI.user_error!("Shorebird CLI not found at #{sb}/shorebird — install it or add it to PATH") unless File.exist?(File.join(sb, "shorebird"))
end

# The Flutter revision Shorebird builds against. Must match a version Shorebird
# supports; the last known-good invocation used 3.44.2. Keep in sync with the
# Flutter used by the plain lanes.
SHOREBIRD_FLUTTER_VERSION = "3.44.2".freeze

# Run a shorebird subcommand from the Flutter project root, with the SAME
# --dart-define flavor wiring the plain `flutter build` lanes use (passed after
# the `--` separator straight through to `flutter build`).
def shorebird(subcommand, flavor)
  ensure_shorebird_on_path
  defines = "--dart-define=FLAVOR=#{flavor} --dart-define=FLUTTER_FLAVOR=#{flavor}"
  Dir.chdir(FLUTTER_DIR) do
    sh("shorebird #{subcommand} android --flavor #{flavor} " \
       "--flutter-version=#{SHOREBIRD_FLUTTER_VERSION} --artifact aab --no-confirm " \
       "-- #{defines} #{COMPRESSION_FLAGS}")
  end
end

# Resolve the Play Console service-account JSON path. One Play account
# hosts one app (com.lazervault.app) across three tracks (internal /
# alpha / production), so one SA drives every Android upload. The SA
# lives in lazervault-28875 (prod GCP project — canonical home for the
# production listing). Per-env Firebase routing is separate — the AAB
# bundles the matching google-services.json from android/app/src/<env>/.
def play_store_json_key_path
  ENV["PLAY_STORE_JSON_KEY"]
end

# Deploy model:
#   PRIMARY (release-signed AAB → Play Console):
#     dev        → Play Console internal track       (no review, instant rollout)
#     staging    → Play Console closed (alpha) track (gated tester groups, no review)
#     production → Play Console production track     (Play review, full rollout)
#
#   ALTERNATE (debug-signed APK → Firebase App Distribution):
#     dev_firebase     — fast iteration; ad-hoc testers; no Play review
#     staging_firebase — same pattern for staging Firebase project
#
# Signing:
#   All Play Console uploads use the upload keystore at
#   ~/.config/play-store/lazervault-upload-keystore.jks (Play App Signing
#   re-signs with the prod key on Google's side).
#   Firebase lanes use the debug keystore (no setup needed).
platform :android do
  # release_status policy:
  #   internal + alpha → "completed"  (auto-rollout to internal/closed testers,
  #                                    no Play review, mirrors TestFlight Internal
  #                                    behaviour — uploads go straight to testers)
  #   production       → "draft"      (uploaded but rollout HELD; flip to
  #                                    "Start rollout to production" in Play
  #                                    Console UI when ready — keeps a final
  #                                    human gate before public release)
  # STORE_FLAVOR: every Play track (internal/alpha/production) ships the PROD
  # product flavor — FLUTTER_FLAVOR=prod (→ api.lazervault.app gateways, compiled
  # in, see app_environment.dart) + the prod google-services.json. The lane name
  # picks the TRACK, not the backend: internal & alpha testers exercise the REAL
  # prod backend + Firebase, same as production. The dev/staging flavors are
  # emulator-only (scripts/run_app_emulator.sh). Was previously flavor=dev/staging
  # here, which silently shipped the DEV backend to internal/alpha.
  STORE_FLAVOR = "prod".freeze

  desc "Dev → Play Console internal track (PROD build: prod backend/Firebase, auto-rolls to internal testers)"
  lane :dev do |options|
    use_env("prod") # internal track tests against the PROD backend
    purge_stale_aab(STORE_FLAVOR)
    build_release_aab(STORE_FLAVOR)
    UI.success("Built fresh AAB: #{aab_for(STORE_FLAVOR)} (#{File.size(aab_for(STORE_FLAVOR))} bytes)")
    upload_to_play_store(
      package_name:               "com.lazervault.app",
      track:                      "internal",
      aab:                        aab_for(STORE_FLAVOR),
      json_key:                   play_store_json_key_path,
      skip_upload_apk:            true,
      skip_upload_metadata:       true,
      skip_upload_changelogs:     false,
      skip_upload_images:         true,
      skip_upload_screenshots:    true,
      release_status:             "completed",
    )
  end

  desc "Staging → Play Console closed (alpha) track (PROD build: prod backend/Firebase, auto-rolls to alpha testers)"
  lane :staging do |options|
    use_env("prod") # alpha track tests against the PROD backend
    purge_stale_aab(STORE_FLAVOR)
    build_release_aab(STORE_FLAVOR)
    upload_to_play_store(
      package_name:               "com.lazervault.app",
      track:                      "alpha",
      aab:                        aab_for(STORE_FLAVOR),
      json_key:                   play_store_json_key_path,
      skip_upload_apk:            true,
      skip_upload_metadata:       true,
      skip_upload_changelogs:     false,
      skip_upload_images:         true,
      skip_upload_screenshots:    true,
      release_status:             "completed",
    )
  end

  desc "Production → Play Console production track (release-signed AAB, HOLDS rollout in draft)"
  lane :production do |options|
    use_env("prod")
    purge_stale_aab("prod")
    build_release_aab("prod")
    upload_to_play_store(
      package_name:               "com.lazervault.app",
      track:                      "production",
      aab:                        aab_for("prod"),
      json_key:                   play_store_json_key_path,
      skip_upload_apk:            true,
      skip_upload_metadata:       true,
      skip_upload_changelogs:     false,
      skip_upload_images:         true,
      skip_upload_screenshots:    true,
      release_status:             "draft",  # Manual gate — flip in Play Console when ready
    )
  end

  desc "Promote alpha → production (no rebuild, just track switch)"
  lane :promote_to_production do
    upload_to_play_store(
      package_name:               "com.lazervault.app",
      json_key:                   play_store_json_key_path,
      track:                      "alpha",
      track_promote_to:           "production",
      skip_upload_apk:            true,
      skip_upload_aab:            true,
      skip_upload_metadata:       true,
      skip_upload_changelogs:     true,
      skip_upload_images:         true,
      skip_upload_screenshots:    true,
      release_status:             "draft",
    )
  end

  desc "Dev fallback → Firebase App Distribution (debug-signed APK, no keystore needed)"
  lane :dev_firebase do
    flutter("build apk --flavor dev --dart-define=FLAVOR=dev --dart-define=FLUTTER_FLAVOR=dev --debug --split-per-abi")
    args = {
      app: "1:961906506476:android:ec73b0375c4900043843c9",  # lazervault-dev Android app
      android_artifact_type: "APK",
      android_artifact_path: apk_arm64_for("dev", "debug"),
      release_notes: release_notes,
      service_credentials_file: ENV["FIREBASE_SERVICE_ACCOUNT_JSON"],
      firebase_cli_token: ENV["FIREBASE_TOKEN"],
    }
    args[:groups] = ENV["FAD_GROUPS"] if ENV["FAD_GROUPS"] && !ENV["FAD_GROUPS"].empty?
    firebase_app_distribution(args)
  end

  desc "Staging fallback → Firebase App Distribution (debug-signed APK)"
  lane :staging_firebase do
    flutter("build apk --flavor staging --dart-define=FLAVOR=staging --dart-define=FLUTTER_FLAVOR=staging --debug --split-per-abi")
    args = {
      app: "1:169699168674:android:f9025cedabdafadd4b22fb",  # lazervault-testnet Android app
      android_artifact_type: "APK",
      android_artifact_path: apk_arm64_for("staging", "debug"),
      release_notes: release_notes,
      service_credentials_file: ENV["FIREBASE_SERVICE_ACCOUNT_JSON"],
      firebase_cli_token: ENV["FIREBASE_TOKEN"],
    }
    args[:groups] = ENV["FAD_GROUPS"] if ENV["FAD_GROUPS"] && !ENV["FAD_GROUPS"].empty?
    firebase_app_distribution(args)
  end

  # --- Shorebird OTA code-push lanes (additive; plain lanes above are unchanged)
  # These are ONLY invoked via the --shorebird / --patch deploy flags. They do NOT
  # replace the normal build lanes — a plain deploy never calls them.
  #
  # shorebird_release: builds a PATCH-CAPABLE release AAB (ships as a normal new
  #   build to Play Console, but is now patchable via `shorebird patch`). Pass
  #   flavor:<f> (default prod, same as the store lanes). The AAB it produces is
  #   uploaded to the internal track here; promote in Play Console as usual.
  desc "Shorebird patch-capable RELEASE (AAB) → Play Console internal track"
  lane :shorebird_release do |options|
    flavor = (options[:flavor] || STORE_FLAVOR).to_s
    use_env("prod")
    shorebird("release", flavor)
    aab = aab_for(flavor)
    UI.user_error!("Shorebird release produced no AAB at #{aab}") unless File.exist?(aab)
    UI.success("Built patch-capable AAB: #{aab} (#{File.size(aab)} bytes)")
    upload_to_play_store(
      package_name:               "com.lazervault.app",
      track:                      "internal",
      aab:                        aab,
      json_key:                   play_store_json_key_path,
      skip_upload_apk:            true,
      skip_upload_metadata:       true,
      skip_upload_changelogs:     false,
      skip_upload_images:         true,
      skip_upload_screenshots:    true,
      release_status:             "completed",
    )
  end

  # shorebird_patch: pushes a Dart-only OTA PATCH to the already-shipped release
  #   for this flavor. NO version bump, NO store upload — live on devices in
  #   minutes. Requires a prior `shorebird_release` for the same flavor to target.
  desc "Shorebird OTA PATCH (Dart-only) → already-shipped release (no store, no bump)"
  lane :shorebird_patch do |options|
    flavor = (options[:flavor] || STORE_FLAVOR).to_s
    use_env("prod")
    shorebird("patch", flavor)
    UI.success("Shorebird OTA patch pushed for flavor=#{flavor} (no store upload, no build bump)")
  end
end
